---
import BaseLayout from '../layouts/BaseLayout.astro';

// Logos de Partners
const partners = [
  { name: "Aspel", src: "/aspel.webp" },
  { name: "Contalink", src: "/contalink.jpeg" },
  { name: "CONTPAQi", src: "/CONTPQI.png" },
  { name: "IMCP", src: "/imcp.png" },
  { name: "Microsoft", src: "/microsoft.webp" },
  { name: "NOMS", src: "/noms.webp" },
  { name: "Oracle", src: "/oracle.jpg" },
  { name: "Python", src: "/Python.webp" },
  { name: "Quickbooks", src: "/quickboks.jpeg" },
  { name: "SAP", src: "/sap.png" },
  { name: "VSC", src: "/vsc.png" }
];

// Socios Directivos
const socios = [
  { 
    name: "Juan Carlos Guzmán Herrera", 
    role: "Socio Consultor", 
    img: "/carlos.jpeg",
    email: "carlosgh@nrgconsulting.mx"
  },
  { 
    name: "Miguel Ángel Nava Velázquez", 
    role: "Socio Consultor", 
    img: "/angel.jpeg",
    email: "angelv@nrgconsulting.mx"
  },
  { 
    name: "Antonio Rubio Basaldua", 
    role: "Socio Consultor", 
    img: "/antonio.jpeg",
    email: "antoniorb@nrgconsulting.mx"
  }
];

// Estructura Operativa y Legal
const colaboradores = [
  { 
    name: "María Guadalupe Hernández Delgado", 
    role: "Analista de Operaciones", 
    img: "/maria.jpeg",
    email: "maria@nrgconsulting.mx"
  },
  { 
    name: "Carlos Emiliano Mora Montes", 
    role: "Servicio Legal Asociado", 
    email: "contacto@nrgconsulting.mx"
  }
];
---

<BaseLayout title="Nuestra Firma | NRG Consulting">

  <!-- HERO SECTION -->
  <section class="relative py-32 px-8 overflow-hidden">
    <div class="absolute inset-0 bg-neutral-900">
      <div class="absolute inset-0 opacity-20 bg-[url('https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&q=80')] bg-cover bg-center"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-transparent to-white"></div>
    </div>
    
    <div class="relative max-w-6xl mx-auto z-10 pt-16">
      <span class="text-[10px] font-bold tracking-[0.4em] text-emerald-600 uppercase mb-6 block drop-shadow-sm">Nuestra Firma</span>
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <h1 class="text-4xl md:text-6xl font-serif text-neutral-900 leading-tight">
          La vanguardia tecnológica <span class="italic text-emerald-600">al servicio de su estructura fiscal</span>.
        </h1>
        <div class="space-y-6 text-neutral-700 text-lg font-light border-l-2 border-emerald-500 pl-8 bg-white/40 backdrop-blur-md p-8 rounded-r-2xl shadow-sm">
          <p>
            En NRG Consulting, nuestra práctica trasciende la consultoría tradicional. Fundamentados en el <strong>Principio de Control Total</strong>, integramos una visión multidisciplinaria que combina la precisión contable, la estrategia fiscal y el blindaje legal, todo potenciado por soluciones tecnológicas a medida.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SECCIÓN PRINCIPAL DE CONTENIDO -->
  <section class="py-12 px-8 bg-white">
    <div class="max-w-6xl mx-auto">
      
      <!-- PILARES ESTRATÉGICOS -->
      <div class="grid md:grid-cols-3 gap-8 mb-28 border-y border-neutral-100 py-12">
        <div class="text-center md:text-left border-l-2 border-emerald-500 pl-6">
          <h4 class="text-xs font-bold tracking-widest text-neutral-900 uppercase">Visión Integral</h4>
          <p class="text-xs text-neutral-500 mt-2 font-light leading-relaxed">Conexión directa entre la estrategia fiscal, contable y el marco legal corporativo.</p>
        </div>
        
        <div class="text-center md:text-left border-l-2 border-emerald-500 pl-6">
          <h4 class="text-xs font-bold tracking-widest text-neutral-900 uppercase">Tecnología Aplicada</h4>
          <p class="text-xs text-neutral-500 mt-2 font-light leading-relaxed">Automatización de flujos y sistemas avanzados para el control total de operaciones.</p>
        </div>

        <div class="text-center md:text-left border-l-2 border-emerald-500 pl-6">
          <h4 class="text-xs font-bold tracking-widest text-neutral-900 uppercase">Atención Senior</h4>
          <p class="text-xs text-neutral-500 mt-2 font-light leading-relaxed">Acompañamiento directo por parte de los socios consultores en cada proyecto.</p>
        </div>
      </div>

      <!-- SECCIÓN EQUIPO DIRECCIÓN -->
      <div class="mb-24">
        <div class="flex items-center justify-between mb-12 border-b border-neutral-100 pb-4">
          <h2 class="text-[10px] font-bold tracking-[0.4em] uppercase text-neutral-400">
            Dirección Estratégica
          </h2>
          <span class="text-xs text-neutral-400 font-mono">Socios Consultores</span>
        </div>

        <!-- Grid de Socios Principales (3 Columnas) -->
        <div class="grid md:grid-cols-3 gap-8">
          {socios.map((socio) => (
            <div class="relative bg-white p-8 border border-neutral-100 shadow-sm hover:shadow-xl hover:-translate-y-2 hover:border-emerald-200 transition-all duration-500 ease-out group overflow-hidden flex flex-col justify-between">
              <div>
                <!-- Avatar Circular Limpio -->
                <div class="w-24 h-24 mb-6 mx-auto bg-neutral-100 overflow-hidden rounded-full shadow-inner border border-neutral-200 flex items-center justify-center group-hover:border-emerald-500 transition-all duration-500">
                  <img 
                    src={socio.img} 
                    alt={socio.name}
                    class="w-full h-full object-cover grayscale group-hover:grayscale-0 scale-100 group-hover:scale-105 transition-all duration-700"
                    onerror="this.onerror=null; this.src='/logo.pgn.jpeg'; this.style.opacity='0.3';" 
                  />
                </div>

                <!-- Nombre y Puesto -->
                <div class="text-center">
                  <span class="text-[9px] font-bold tracking-[0.2em] text-emerald-600 uppercase block mb-1">
                    {socio.role}
                  </span>
                  <h3 class="text-lg font-bold text-neutral-950 leading-snug mb-4">
                    {socio.name}
                  </h3>
                </div>
              </div>

              <!-- Correo Únicamente -->
              <div class="pt-4 mt-6 border-t border-neutral-100 text-center">
                <a 
                  href={`mailto:${socio.email}`} 
                  class="text-xs text-neutral-500 hover:text-emerald-600 font-mono block transition-colors truncate"
                  title={socio.email}
                >
                  {socio.email}
                </a>
              </div>

              <!-- Barra Inferior de Acento en Hover -->
              <div class="absolute bottom-0 left-0 w-0 h-1 bg-emerald-600 group-hover:w-full transition-all duration-500 ease-in-out"></div>
            </div>
          ))}
        </div>
      </div>

      <!-- SUB-SECCIÓN OPERACIONES & ALIADOS -->
      <div class="mb-32">
        <h3 class="text-[10px] font-bold tracking-[0.4em] uppercase text-neutral-400 mb-8 border-b border-neutral-100 pb-4">
          Estructura Operativa & Servicios Asociados
        </h3>

        <!-- Tarjetas Horizontales (2 Columnas) -->
        <div class="grid md:grid-cols-2 gap-6">
          {colaboradores.map((item) => (
            <div class="relative bg-white border border-neutral-200 p-8 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-sm hover:shadow-md hover:border-emerald-600 transition-all duration-300 group overflow-hidden">
              
              <div class="relative z-10 flex flex-col sm:flex-row items-center sm:items-start text-center sm:text-left gap-6">
                {/* Avatar idéntico en tamaño a los socios (w-24 h-24) */}
                {item.img && (
                  <div class="w-24 h-24 shrink-0 bg-neutral-100 overflow-hidden rounded-full shadow-inner border border-neutral-200 flex items-center justify-center group-hover:border-emerald-500 transition-all duration-500">
                    <img 
                      src={item.img} 
                      alt={item.name}
                      class="w-full h-full object-cover grayscale group-hover:grayscale-0 scale-100 group-hover:scale-105 transition-all duration-700"
                      onerror="this.onerror=null; this.src='/logo.pgn.jpeg'; this.style.opacity='0.3';" 
                    />
                  </div>
                )}
                
                <div class="flex flex-col justify-center h-full pt-1">
                  <span class="text-[9px] font-bold tracking-[0.2em] text-neutral-400 group-hover:text-emerald-600 transition-colors uppercase block mb-1">
                    {item.role}
                  </span>
                  <h4 class="text-base font-bold text-neutral-950 leading-snug">{item.name}</h4>
                </div>
              </div>

              <!-- Correo Únicamente -->
              <div class="relative z-10 text-center sm:text-right shrink-0 border-t sm:border-t-0 pt-3 sm:pt-0 border-neutral-100 w-full sm:w-auto">
                <a href={`mailto:${item.email}`} class="text-xs text-neutral-500 hover:text-emerald-600 block transition-colors font-mono">
                  {item.email}
                </a>
              </div>

              <div class="absolute top-0 right-0 w-24 h-full bg-gradient-to-l from-emerald-50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>

  <!-- FRASE / MANIFIESTO -->
  <section class="py-24 bg-neutral-50 px-8 text-center border-t border-neutral-100">
    <h2 class="text-2xl md:text-4xl font-serif text-neutral-900 italic max-w-3xl mx-auto leading-relaxed">
      "El Principio de Control Total no es solo una metodología, es nuestro compromiso con la integridad de su patrimonio."
    </h2>
  </section>

  <!-- MARQUEE PARTNERS -->
  <section class="py-16 bg-white border-y border-neutral-100">
    <div class="max-w-6xl mx-auto px-8 text-center mb-10">
      <h3 class="text-[10px] font-bold tracking-[0.4em] uppercase text-neutral-400">Tecnología y Alianzas Estratégicas</h3>
    </div>
    
    <div class="relative max-w-6xl mx-auto overflow-hidden">
      <div class="flex animate-marquee gap-24 items-center whitespace-nowrap">
        {[...partners, ...partners].map((p) => (
          <div class="flex-shrink-0 flex items-center justify-center w-40 h-20 transition-all duration-500 hover:scale-110 cursor-default opacity-100">
            <img 
              src={p.src} 
              alt={p.name} 
              class="max-h-16 w-auto object-contain" 
              style="filter: none !important;"
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- INFRAESTRUCTURA OPERATIVA -->
  <section class="bg-neutral-950 py-24 px-8 relative overflow-hidden">
    <div class="absolute top-1/4 right-0 w-1/2 h-1/2 bg-emerald-900/20 blur-[150px] rounded-full pointer-events-none"></div>
    <div class="max-w-6xl mx-auto relative z-10">
      <h2 class="text-sm font-bold tracking-[0.2em] uppercase text-emerald-500 mb-16 border-b border-neutral-800 pb-4">Infraestructura Operativa</h2>
      <div class="grid md:grid-cols-3 gap-x-12 gap-y-16">
        {[
          { t: "Finanzas y Cumplimiento", d: "Contabilidad, impuestos, nóminas e IMSS con planeación fiscal ética." },
          { t: "Estrategia de Negocios", d: "Proyectos de inversión, planes de negocio y control interno." },
          { t: "Automatización y Tech", d: "Desarrollo a la medida, automatización de flujos financieros y plataformas web." },
          { t: "Consultoría Legal", d: "Blindaje legal corporativo y defensa estratégica en alianza." },
          { t: "Comercio Exterior", d: "Logística internacional y regímenes aduaneros especializados." },
          { t: "Control de Gestión", d: "Mitigación de riesgos y arquitectura de sistemas para toma de decisiones." }
        ].map(dept => (
          <div class="group border-l-2 border-neutral-800 pl-8 hover:border-emerald-500 transition-all duration-300">
            <h4 class="text-sm font-bold mb-4 text-white group-hover:text-emerald-400 transition-colors">{dept.t}</h4>
            <p class="text-xs text-neutral-400 font-light group-hover:text-neutral-300 transition-colors">{dept.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FOOTER BANNER / VALORES -->
  <section class="py-24 px-8 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-3 gap-12 text-center">
        {[ 
          {t: "Automatización", d: "Procesos digitales"}, 
          {t: "Control Total", d: "Blindaje institucional"}, 
          {t: "Estrategia", d: "Visión corporativa"} 
        ].map(m => (
          <div class="group cursor-default hover:-translate-y-2 transition-transform duration-500">
             <div class="w-16 h-16 border border-neutral-200 group-hover:border-emerald-600 group-hover:bg-emerald-50 mx-auto mb-6 flex items-center justify-center transition-all duration-500 rotate-45 group-hover:rotate-0">
                <div class="w-2 h-2 bg-emerald-600 rounded-full"></div>
             </div>
             <h4 class="font-bold text-neutral-950">{m.t}</h4>
             <p class="text-[10px] text-neutral-400 uppercase tracking-widest mt-2">{m.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  
</BaseLayout>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee {
    animation: marquee 30s linear infinite;
  }
</style>