---
import BaseLayout from '../layouts/BaseLayout.astro';

// Logos de Partners / Alianzas
const partners = [
  { name: "Aspel", src: "/aspel.webp" },
  { name: "Contalink", src: "/contalink.jpeg" },
  { name: "CONTPAQi", src: "/CONTPQI.png" },
  { name: "IMCP", src: "/imcp.png" },
  { name: "Microsoft", src: "/microsoft.webp" },
  { name: "NOMS", src: "/noms.webp" },
  { name: "Oracle", src: "/oracle.jpg" },
  { name: "Python", src: "/Python.webp" },
  { name: "Quickbooks", src: "/quickboks.jpeg" },
  { name: "SAP", src: "/sap.png" },
  { name: "VSC", src: "/vsc.png" }
];

// Socios Consultores (Nivel Directivo)
const socios = [
  { 
    name: "Juan Carlos Guzmán Herrera", 
    role: "Socio Consultor", 
    tag: "Auditoría & Consultoría",
    img: "/carlos.jpeg",
    email: "carlosgh@nrgconsulting.mx",
    phone: "+52 442 000 0000"
  },
  { 
    name: "Antonio Rubio Basaldua", 
    role: "Socio Consultor", 
    tag: "Reingeniería & Gestión",
    img: "/antonio.jpeg",
    email: "antoniorb@nrgconsulting.mx",
    phone: "+52 442 000 0000"
  },
  { 
    name: "Miguel Ángel Nava Velázquez", 
    role: "Socio Consultor", 
    tag: "Comercio Exterior & Tech",
    img: "/angel.jpeg",
    email: "angelv@nrgconsulting.mx",
    phone: "+52 442 000 0000"
  }
];

// Equipo Operativo & Aliados
const equipoOperativo = [
  { 
    name: "María Guadalupe Hernández Delgado", 
    role: "Analista de Operaciones", 
    area: "Control & Procesos Internos",
    img: "/guadalupe.jpeg",
    email: "maria@nrgconsulting.mx",
    phone: "+52 442 000 0000"
  },
  { 
    name: "Carlos Emiliano Mora Montes", 
    role: "Servicio Legal Asociado", 
    area: "Defensa Corporativa & Blindaje",
    img: "/logo.pgn.jpeg", // o avatar/logo
    email: "contacto@nrgconsulting.mx",
    phone: "+52 442 000 0000"
  }
];
---

<BaseLayout title="Nuestra Firma | NRG Consulting">

  <!-- HERO SECTION CON EFECTO GLASS -->
  <section class="relative py-36 px-6 md:px-12 overflow-hidden bg-neutral-950 text-white">
    <!-- Luces de fondo -->
    <div class="absolute top-0 left-1/4 w-96 h-96 bg-emerald-600/15 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="absolute bottom-0 right-1/4 w-96 h-96 bg-emerald-900/20 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto z-10 pt-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-semibold uppercase tracking-widest mb-8">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        Nuestra Firma
      </div>

      <div class="grid lg:grid-cols-12 gap-12 items-end">
        <div class="lg:col-span-7">
          <h1 class="text-4xl sm:text-5xl md:text-6xl font-serif font-light text-white leading-[1.15] tracking-tight">
            La vanguardia tecnológica <br class="hidden sm:inline" />
            <span class="italic font-normal text-emerald-400">al servicio de su estructura fiscal.</span>
          </h1>
        </div>

        <div class="lg:col-span-5">
          <div class="p-8 rounded-2xl bg-white/[0.03] backdrop-blur-xl border border-white/10 shadow-2xl relative overflow-hidden group hover:border-emerald-500/30 transition-all duration-500">
            <div class="absolute top-0 left-0 w-1 h-full bg-emerald-500"></div>
            <p class="text-neutral-300 text-base md:text-lg font-light leading-relaxed">
              En <strong class="text-white font-medium">NRG Consulting</strong> trascendemos la consultoría tradicional. Fundamentados en el <span class="text-emerald-400 font-normal">Principio de Control Total</span>, integramos contabilidad de precisión, estrategia fiscal y blindaje legal potenciado por soluciones tecnológicas.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>


  <!-- MÉTRICAS DE IMPACTO -->
  <section class="bg-neutral-900 border-y border-neutral-800/80 py-12 px-6">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-8">
      {[ 
        { n: "+100", label: "Proyectos Ejecutados", sub: "Casos de éxito" }, 
        { n: "100%", label: "Control de Gestión", sub: "Garantía de precisión" }, 
        { n: "+5", label: "Años de Experiencia", sub: "Trayectoria consolidada" }, 
        { n: "24/7", label: "Soporte Operativo", sub: "Atención continua" } 
      ].map(metric => (
        <div class="p-4 border-l border-neutral-800 pl-6 hover:border-emerald-500 transition-colors duration-300">
          <div class="text-3xl sm:text-4xl font-bold font-mono text-white mb-1">{metric.n}</div>
          <div class="text-xs font-semibold text-emerald-400 uppercase tracking-wider">{metric.label}</div>
          <div class="text-[11px] text-neutral-500 mt-1">{metric.sub}</div>
        </div>
      ))}
    </div>
  </section>


  <!-- SECCIÓN DE EQUIPO DIRECCIÓN & OPERACIONES -->
  <section class="py-28 px-6 md:px-12 bg-neutral-950 text-white relative">
    <div class="max-w-7xl mx-auto">
      
      <!-- Encabezado de Sección -->
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 pb-6 border-b border-neutral-800">
        <div>
          <span class="text-emerald-500 text-xs font-bold uppercase tracking-[0.3em] block mb-2">Liderazgo Corporativo</span>
          <h2 class="text-3xl md:text-4xl font-serif text-white">Dirección Estratégica</h2>
        </div>
        <p class="text-neutral-400 text-sm max-w-md mt-4 md:mt-0 font-light">
          Socios directores al frente de la toma de decisiones, garantizando ética, rigor técnico e innovación tecnológica.
        </p>
      </div>

      <!-- GRID DE SOCIOS (3 Tarjetas Principales Eleantes) -->
      <div class="grid md:grid-cols-3 gap-8 mb-20">
        {socios.map((socio) => (
          <div class="group relative rounded-2xl bg-neutral-900/60 border border-neutral-800/80 p-8 hover:border-emerald-500/50 hover:bg-neutral-900 transition-all duration-500 flex flex-col justify-between overflow-hidden shadow-xl">
            <!-- Glow hover effect -->
            <div class="absolute -right-10 -top-10 w-32 h-32 bg-emerald-500/10 rounded-full blur-2xl group-hover:bg-emerald-500/20 transition-all duration-500"></div>

            <div>
              <!-- Header Tarjeta -->
              <div class="flex items-center justify-between mb-6">
                <span class="text-[10px] font-bold tracking-widest text-emerald-400 uppercase px-2.5 py-1 rounded-md bg-emerald-950/80 border border-emerald-800/50">
                  {socio.tag}
                </span>
                <span class="text-xs text-neutral-500 font-mono">01 / SOCIO</span>
              </div>

              <!-- Foto e Info -->
              <div class="flex items-center gap-5 mb-6">
                <div class="relative w-20 h-20 rounded-xl overflow-hidden border border-neutral-700/60 group-hover:border-emerald-400 transition-all duration-500 shrink-0">
                  <img 
                    src={socio.img} 
                    alt={socio.name}
                    class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700"
                    onerror="this.onerror=null; this.src='/logo.pgn.jpeg'; this.style.opacity='0.5';"
                  />
                </div>
                <div>
                  <h3 class="text-lg font-bold text-white group-hover:text-emerald-300 transition-colors leading-tight">
                    {socio.name}
                  </h3>
                  <p class="text-xs text-neutral-400 mt-1">{socio.role}</p>
                </div>
              </div>
            </div>

            <!-- Botones de Contacto Directo -->
            <div class="pt-6 border-t border-neutral-800/80 flex flex-col gap-2">
              <a 
                href={`mailto:${socio.email}`}
                class="flex items-center justify-between px-3 py-2 rounded-lg bg-neutral-800/40 hover:bg-emerald-500/10 border border-transparent hover:border-emerald-500/30 text-xs text-neutral-300 hover:text-emerald-400 transition-all duration-300 group/link"
              >
                <span class="truncate">{socio.email}</span>
                <svg class="w-3.5 h-3.5 text-neutral-500 group-hover/link:text-emerald-400 group-hover/link:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>

              <a 
                href={`tel:${socio.phone.replace(/\s+/g, '')}`}
                class="flex items-center justify-between px-3 py-2 rounded-lg bg-neutral-800/20 hover:bg-neutral-800 text-xs font-mono text-neutral-400 hover:text-white transition-all duration-300"
              >
                <span>{socio.phone}</span>
                <svg class="w-3.5 h-3.5 text-neutral-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </a>
            </div>
          </div>
        ))}
      </div>


      <!-- SUB-SECCIÓN: OPERACIONES Y ALIADOS (Estructura Horizontal Limpia) -->
      <div class="mt-16 pt-12 border-t border-neutral-800">
        <span class="text-neutral-400 text-xs font-bold uppercase tracking-[0.25em] block mb-8">
          Estructura Operativa & Aliados
        </span>

        <div class="grid lg:grid-cols-2 gap-6">
          {equipoOperativo.map((miembro) => (
            <div class="p-6 rounded-xl bg-neutral-900/40 border border-neutral-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 hover:border-neutral-700 transition-all duration-300">
              <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-lg bg-neutral-800 overflow-hidden border border-neutral-700 shrink-0">
                  <img 
                    src={miembro.img} 
                    alt={miembro.name}
                    class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500"
                    onerror="this.onerror=null; this.src='/logo.pgn.jpeg'; this.style.opacity='0.4';"
                  />
                </div>
                <div>
                  <span class="text-[10px] font-semibold text-emerald-400 uppercase tracking-wider block">
                    {miembro.role}
                  </span>
                  <h4 class="text-base font-bold text-white mt-0.5">{miembro.name}</h4>
                  <p class="text-xs text-neutral-400 font-light">{miembro.area}</p>
                </div>
              </div>

              <!-- Contactos -->
              <div class="flex sm:flex-col gap-3 sm:gap-1 text-xs w-full sm:w-auto border-t sm:border-t-0 pt-3 sm:pt-0 border-neutral-800">
                <a href={`mailto:${miembro.email}`} class="text-emerald-400 hover:underline font-mono truncate">
                  {miembro.email}
                </a>
                <a href={`tel:${miembro.phone.replace(/\s+/g, '')}`} class="text-neutral-400 hover:text-white font-mono">
                  {miembro.phone}
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>


  <!-- CITA/VALORES DE MARCA -->
  <section class="py-20 px-6 bg-white text-neutral-900 border-y border-neutral-200">
    <div class="max-w-4xl mx-auto text-center">
      <span class="text-emerald-600 text-4xl font-serif block mb-4">“</span>
      <h2 class="text-2xl md:text-3xl font-serif italic leading-relaxed text-neutral-900">
        El Principio de Control Total no es solo una metodología de trabajo, es nuestro compromiso inquebrantable con la trascendencia y seguridad de su patrimonio.
      </h2>
      <div class="mt-6 w-12 h-0.5 bg-emerald-500 mx-auto"></div>
    </div>
  </section>


  <!-- SLIDER INFINITO DE PARTNERS -->
  <section class="py-16 bg-neutral-900 text-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-6 mb-8 text-center">
      <span class="text-[10px] font-bold tracking-[0.3em] uppercase text-neutral-400">Tecnologías & Alianzas Integradas</span>
    </div>
    
    <div class="relative w-full overflow-hidden">
      <div class="flex animate-marquee gap-16 items-center whitespace-nowrap">
        {[...partners, ...partners].map((p) => (
          <div class="flex-shrink-0 flex items-center justify-center w-36 h-16 opacity-70 hover:opacity-100 transition-opacity duration-300">
            <img 
              src={p.src} 
              alt={p.name} 
              class="max-h-12 w-auto object-contain filter grayscale hover:grayscale-0 transition-all duration-300" 
            />
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- INFRAESTRUCTURA OPERATIVA (SERVICIOS) -->
  <section class="bg-neutral-950 py-28 px-6 md:px-12 text-white">
    <div class="max-w-7xl mx-auto">
      <div class="mb-16 pb-6 border-b border-neutral-800">
        <span class="text-emerald-500 text-xs font-bold uppercase tracking-[0.3em] block mb-2">Capacidades</span>
        <h2 class="text-3xl md:text-4xl font-serif">Infraestructura Operativa</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        {[
          { title: "Finanzas y Cumplimiento", desc: "Contabilidad, impuestos, nóminas e IMSS respaldados por planeación fiscal ética y estructurada." },
          { title: "Estrategia de Negocios", desc: "Evaluación de proyectos de inversión, planes de negocio ejecutivos y control interno." },
          { title: "Automatización & Tech", desc: "Desarrollo de software a medida, automatización de flujos financieros y plataformas web." },
          { title: "Consultoría Legal", desc: "Blindaje legal corporativo, gestión de contratos y defensa estratégica en alianza." },
          { title: "Comercio Exterior", desc: "Gestión de logística internacional, regímenes aduaneros y cumplimiento regulatorio." },
          { title: "Control de Gestión", desc: "Arquitectura de datos para la mitigación de riesgos y decisiones en tiempo real." }
        ].map((item, index) => (
          <div class="p-8 rounded-2xl bg-neutral-900/40 border border-neutral-800/80 hover:border-emerald-500/40 hover:bg-neutral-900 transition-all duration-300 group">
            <div class="text-emerald-500 text-xs font-mono font-bold mb-4">0{index + 1} //</div>
            <h3 class="text-lg font-bold text-white group-hover:text-emerald-300 transition-colors mb-3">{item.title}</h3>
            <p class="text-xs text-neutral-400 font-light leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .animate-marquee {
    animation: marquee 35s linear infinite;
  }
</style>